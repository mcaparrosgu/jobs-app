# ═══════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO — Jobs App
# ═══════════════════════════════════════════════════════════════
#
#  Este archivo SÍ se sube a git: solo tiene los NOMBRES de las
#  claves, nunca los valores.
#
#  Para trabajar en tu ordenador:
#    1. Copia este archivo y llámalo  .env.local
#    2. Rellena los valores reales ahí
#    3. .env.local NUNCA se sube (ya está en .gitignore)
#
#  ⚠ Todo lo que empieza por NEXT_PUBLIC_ viaja al navegador y
#    CUALQUIERA puede leerlo. Es como escribirlo en el escaparate.
#    Solo pueden llevar ese prefijo las claves que no importan.
#
# ═══════════════════════════════════════════════════════════════


# ─── Supabase (base de datos y acceso por email) ───────────────
#
# Dónde se sacan: supabase.com → tu proyecto → Project Settings
#                 → API
#
# Dónde van los valores reales en producción:
#   Vercel → tu proyecto → Settings → Environment Variables

# Dirección de tu base de datos. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=

# Clave de acceso público. No es secreta: lo que impide que alguien
# vea datos ajenos con ella es RLS, la regla de la base de datos que
# hace que cada ficha solo se entregue a su dueña.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 SECRETA. Acceso total, se salta RLS.
#    Jamás en un archivo de app/ que vea el navegador.
#    Jamás con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─── OpenRouter (el modelo de IA) ──────────────────────────────
#
# Dónde se saca: openrouter.ai → Keys
#
# Ver knowledge/decision-modelo-ia.md: se eligió sobre Groq porque
# ofrece una lista de modelos gratis (":free") intercambiables, en
# vez de depender de uno solo que puede retirarse sin aviso.
#
# Dónde va el valor real en producción:
#   Vercel → tu proyecto → Settings → Environment Variables

# 🔴 SECRETA. Quien la tenga consume tu cuota.
OPENROUTER_API_KEY=


# ═══════════════════════════════════════════════════════════════
#  CLAVES QUE NO VAN EN ESTE ARCHIVO
# ═══════════════════════════════════════════════════════════════
#
#  Contraseña SMTP de Gmail (para enviar el enlace de acceso)
#    → Supabase → Project Settings → Authentication → SMTP Settings
#
#  Credenciales de Gmail y de Apify (ingesta de ofertas y avisos)
#    → n8n → Credentials  (ya están ahí, no se tocan)
#
# ═══════════════════════════════════════════════════════════════
