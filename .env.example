# ═══════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO — Jobs App
# ═══════════════════════════════════════════════════════════════
#
#  Este archivo SÍ se sube a git: solo tiene los NOMBRES de las
#  claves, nunca los valores.
#
#  Para trabajar en tu ordenador:
#    1. Copia este archivo y llámalo  .env.local
#    2. Rellena los valores reales ahí
#    3. .env.local NUNCA se sube (ya está en .gitignore)
#
#  ⚠ Todo lo que empieza por NEXT_PUBLIC_ viaja al navegador y
#    CUALQUIERA puede leerlo. Es como escribirlo en el escaparate.
#    Solo pueden llevar ese prefijo las claves que no importan.
#
# ═══════════════════════════════════════════════════════════════


# ─── Supabase (base de datos y acceso por email) ───────────────
#
# Dónde se sacan: supabase.com → tu proyecto → Project Settings
#                 → API
#
# Dónde van los valores reales en producción:
#   Vercel → tu proyecto → Settings → Environment Variables

# Dirección de tu base de datos. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=

# Clave de acceso público. No es secreta: lo que impide que alguien
# vea datos ajenos con ella es RLS, la regla de la base de datos que
# hace que cada ficha solo se entregue a su dueña.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 SECRETA. Acceso total, se salta RLS.
#    Jamás en un archivo de app/ que vea el navegador.
#    Jamás con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Mistral La Plateforme (el modelo de IA, RESPALDO de pago) ─
#
# Dónde se saca: console.mistral.ai → API Keys (con un método de pago
# añadido: la cuenta tiene que estar en pay-as-you-go, no en el nivel
# gratuito "Experiment").
#
# RESPALDO de pago, segundo de la cascada (Cloudflare → Mistral →
# OpenRouter) desde el 02/09/2026, opción C1. Solo se llama si Cloudflare
# falla. El nivel de pago NO entrena con el contenido por defecto, los
# datos están en la UE, y hay un tope de gasto de 10 € en la consola.
# Ver knowledge/decision-mistral-pago.md.
#
# Dónde va el valor real en producción:
#   Vercel → tu proyecto → Settings → Environment Variables
#   (y como secreto de GitHub, para el robot de evals)

# 🔴 SECRETA. Quien la tenga gasta del tope de 10 €.
MISTRAL_API_KEY=


# ─── OpenRouter (último respaldo del modelo de IA) ─────────────
#
# Dónde se saca: openrouter.ai → Keys
#
# Es el ÚLTIMO de la cascada (Cloudflare → Mistral → OpenRouter). En su
# día (20/08/2026) sus modelos gratis podían entrenar con las peticiones
# (o sea, con los CVs); esa opción se apagó — ver
# knowledge/decision-groq-principal-privacidad.md. Al apagarla, sigue
# sirviendo los modelos ":free" con normalidad, pero en la práctica
# devuelve 429 y no respalda nada (T112).
#
# Dónde va el valor real en producción:
#   Vercel → tu proyecto → Settings → Environment Variables

# 🔴 SECRETA. Quien la tenga consume tu cuota.
OPENROUTER_API_KEY=


# ─── Cloudflare Workers AI (el modelo de IA, PRINCIPAL) ────────
#
# Dónde se sacan:
#   - CLOUDFLARE_ACCOUNT_ID: dash.cloudflare.com → panel principal,
#     columna derecha ("Account ID").
#   - CLOUDFLARE_API_TOKEN: dash.cloudflare.com → tu perfil (arriba a
#     la derecha) → API Tokens → Create Token, con permiso de lectura
#     de Workers AI.
#
# Proveedor PRINCIPAL de las dos llamadas desde el 23/08/2026. Ver
# knowledge/decision-cloudflare-generarcv.md (y decision-mistral-pago.md
# para por qué Mistral quedó de respaldo y no de principal).
#
# Nivel gratuito, sin tarjeta: 10.000 "neuronas" al día, se renuevan
# cada día (no es un crédito de un solo uso, a diferencia de Cerebras).
# Cloudflare declara oficialmente que NO entrena con el contenido por
# defecto (a diferencia del nivel gratuito de Gemini, que sí lo hacía
# salvo por la excepción del Espacio Económico Europeo).
#
# Dónde van los valores reales en producción:
#   Vercel → tu proyecto → Settings → Environment Variables

# No es secreto (identifica la cuenta, no da acceso por sí solo), pero
# tampoco tiene sentido publicarlo.
CLOUDFLARE_ACCOUNT_ID=

# 🔴 SECRETA. Quien la tenga consume tu cuota.
CLOUDFLARE_API_TOKEN=


# ═══════════════════════════════════════════════════════════════
#  CLAVES QUE NO VAN EN ESTE ARCHIVO
# ═══════════════════════════════════════════════════════════════
#
#  Contraseña SMTP de Gmail (para enviar el enlace de acceso)
#    → Supabase → Project Settings → Authentication → SMTP Settings
#
#  Credenciales de Gmail y de Apify (ingesta de ofertas y avisos)
#    → n8n → Credentials  (ya están ahí, no se tocan)
#
# ═══════════════════════════════════════════════════════════════
