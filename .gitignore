# ─────────────────────────────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Dependencias (miles de archivos de librerías, no son código tuyo)
/node_modules
/.pnp
.pnp.js

# Next.js (archivos temporales que se regeneran solos)
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Supabase (trabajo temporal de la herramienta local)
.branches
.temp

# Claude Code (ajustes personales de esta máquina)
.claude/settings.local.json

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea

# Registros
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Salidas de una ejecución de los evals (Paso 13) — resultado de -o, no código
evals/promptfoo/resultado-*.json
